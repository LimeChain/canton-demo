{
  "realm": "canton-demo",
  "displayName": "Canton Demo",
  "loginTheme": "canton-demo",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "clientScopes": [
    {
      "name": "daml_ledger_api",
      "description": "Allows normal Canton Ledger API user-token access.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "lightweight.claim": "true"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "lightweight.claim": "true"
          }
        }
      ]
    },
    {
      "name": "canton_demo_admin",
      "description": "Local demo bootstrap scope with privileged participant access.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "canton-demo-ui",
      "name": "Canton Demo UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email",
        "roles",
        "daml_ledger_api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "canton-demo-admin",
      "name": "Canton Demo Bootstrap",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "canton-demo-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "daml_ledger_api",
        "canton_demo_admin"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "canton-demo-pqs",
      "name": "Canton Demo PQS",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "canton-demo-pqs-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "roles",
        "daml_ledger_api"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "canton-demo-smoke",
      "name": "Canton Demo Smoke Tests",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "daml_ledger_api"
      ],
      "optionalClientScopes": []
    }
  ],
